---
import type { Member } from '../data/cast';
interface Props { member: Member; size?: 'lg' | 'md' | 'sm' }
const { member, size = 'md' } = Astro.props;
---
<article class:list={['cast', size]} id={member.slug}>
  <div class="pic"><img src={member.image} alt={member.alt} loading="lazy" width="600" height="750" /></div>
  <div class="text">
    <h3>{member.name}</h3>
    <p class="role">{member.role}</p>
    {size !== 'sm' && <p class="line">{member.line}</p>}
    {size !== 'sm' && member.nod && <p class="nod muted">{member.nod}</p>}
  </div>
</article>

<style>
  .cast { background: var(--panel); border: 1px solid var(--line); border-radius: var(--radius); overflow: hidden; display: flex; flex-direction: column; }
  .pic { aspect-ratio: 4 / 5; background: var(--black); overflow: hidden; }
  .pic img { width: 100%; height: 100%; object-fit: cover; }
  .text { padding: 1.1rem 1.2rem 1.3rem; }
  h3 { margin: 0; }
  .role { font-family: var(--mono); font-size: .75rem; letter-spacing: .1em; text-transform: uppercase; color: var(--evergreen-bright); margin: .25rem 0 .7rem; }
  .line { font-size: .95rem; margin: 0 0 .5rem; }
  .nod { font-size: .85rem; margin: 0; }
  .lg .text { padding: 1.4rem 1.5rem 1.6rem; }
  .lg h3 { font-size: 1.5rem; }
  .sm .text { padding: .7rem .8rem .8rem; }
  .sm h3 { font-size: 1rem; }
  .sm .role { margin-bottom: 0; font-size: .68rem; }
</style>
