---
import type { WorkItem } from '../data/work';
import { statusLabel } from '../data/work';
interface Props { item: WorkItem }
const { item } = Astro.props;
---
<a class:list={['card', item.status]} href={`/work/${item.slug}`}>
  <div class="top">
    <span class="icon" aria-hidden="true">{item.icon}</span>
    <span class:list={['badge', `badge-${item.status}`]}>{statusLabel[item.status]}</span>
  </div>
  <h3>{item.title}</h3>
  <p class="muted">{item.summary}</p>
  <span class="more">{item.status === 'available' ? 'Learn more →' : 'Preview →'}</span>
</a>

<style>
  .card { display: flex; flex-direction: column; padding: 1.4rem; border-radius: var(--radius); background: var(--panel);
    border: 1px solid var(--line); text-decoration: none; color: inherit; transition: border-color .2s, transform .2s; }
  .card:hover { border-color: var(--royal-blue); transform: translateY(-2px); color: inherit; }
  .card.coming-soon { background: transparent; border-style: dashed; }
  .card.coming-soon:hover { border-color: var(--evergreen-bright); }
  .top { display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.2rem; }
  .icon { width: 44px; height: 44px; display: grid; place-items: center; border-radius: 12px; font-size: 1.3rem;
    color: var(--silver-bright); background: linear-gradient(135deg, rgba(47,86,224,.35), rgba(15,107,69,.35));
    border: 1px solid var(--line); }
  h3 { margin-bottom: .3rem; }
  p { flex: 1; margin-bottom: 1rem; font-size: .95rem; }
  .more { font-size: .9rem; color: var(--royal-blue-bright); }
</style>
