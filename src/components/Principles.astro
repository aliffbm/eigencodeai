---
const points = [
  {
    title: 'Agents draft. People approve.',
    text: 'Our AI agents make the drafts. A person signs off on every piece before it goes out, and decides what goes public.',
  },
  {
    title: 'Our own AI staff',
    text: 'We build the agents our content is made with: Iris, Euterpe, Mira and the rest of the team.',
  },
  {
    title: 'Honest labels',
    text: 'Every piece says how it was made: human-made, AI-assisted or fully AI-made.',
  },
];
---
<div class="principles">
  {points.map((p, i) => (
    <div class="p">
      <span class="n">0{i + 1}</span>
      <h3>{p.title}</h3>
      <p class="muted">{p.text}</p>
    </div>
  ))}
</div>

<style>
  .principles { display: grid; gap: 1rem; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); }
  .p { padding: 1.5rem; border-left: 2px solid var(--evergreen); background: linear-gradient(90deg, rgba(15,107,69,.12), transparent); border-radius: 0 var(--radius) var(--radius) 0; }
  .n { font-family: var(--mono); font-size: .8rem; color: var(--royal-blue-bright); display: block; margin-bottom: .6rem; }
  p { margin: 0; }
</style>
