---
import Logo from './Logo.astro';
import { site, nav } from '../data/site';
const year = new Date().getFullYear();
---
<footer class="footer">
  <div class="wrap cols">
    <div>
      <Logo size={28} />
      <p class="muted small">{site.tagline}</p>
    </div>
    <nav aria-label="Footer">
      <ul>{nav.map((i) => <li><a href={i.href}>{i.label}</a></li>)}</ul>
    </nav>
    <div>
      <ul>
        <li><a href={`mailto:${site.email}`}>{site.email}</a></li>
        {site.socials.map((s) => <li><a href={s.url} rel="noopener" target="_blank">{s.label} · {s.handle}</a></li>)}
      </ul>
    </div>
  </div>
  <div class="wrap legal muted">© {year} {site.legalName}. All rights reserved.</div>
</footer>

<style>
  .footer { border-top: 1px solid var(--line); padding: 3rem 0 2rem; background: var(--ink); margin-top: 2rem; }
  .cols { display: grid; gap: 2rem; grid-template-columns: 2fr 1fr 2fr; }
  @media (max-width: 760px) { .cols { grid-template-columns: 1fr; } }
  ul { list-style: none; margin: 0; padding: 0; display: grid; gap: .4rem; }
  a { color: var(--silver); text-decoration: none; font-size: .95rem; }
  a:hover { color: var(--silver-bright); text-decoration: underline; }
  .small { font-size: .9rem; margin-top: .8rem; }
  .legal { font-size: .82rem; margin-top: 2.5rem; padding-top: 1.5rem; border-top: 1px solid var(--line); }
</style>
